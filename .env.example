# Existing Storefront API settings
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Shopify Customer Account API (Public client / OAuth 2.0 with PKCE)
VITE_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-customer-account-client-id
# OAuth rejects localhost. Use an HTTPS tunnel such as ngrok for local auth testing.
VITE_SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=https://your-public-domain.example/
VITE_SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_URI=https://your-public-domain.example/
